{
  "name": "elearny-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "packages/*",
    "frontend/web"
  ],
  "scripts": {
    "dev:web": "npm --prefix frontend/web run dev",
    "build:web": "npm --prefix frontend/web run build",
    "log": "powershell -ExecutionPolicy Bypass -File ./run-log.ps1"
  }
}

