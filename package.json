{
  "name": "elearny-monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10.5.0",
  "workspaces": [
    "frontend/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "expo": "~51.0.0",
    "expo-constants": "~16.0.2",
    "expo-linking": "~6.3.1",
    "expo-updates": "~0.25.27",
    "react-native": "0.74.5",
    "turbo": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "overrides": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "expo-linking": "$expo-linking",
    "expo-constants": "$expo-constants"
  }
}
