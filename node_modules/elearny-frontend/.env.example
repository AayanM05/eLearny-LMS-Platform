# Neither of these is needed for normal local development — Vite's dev-server proxy
# (vite.config.js) already forwards /api/* to localhost:8080 by default. Only set these if
# your backend runs on a different port/host, or you're pointing this frontend at a deployed
# API instead of your local one.

# Overrides where the Vite dev-server proxy forwards /api/* requests to (default: http://localhost:8080)
# VITE_API_PROXY_TARGET=http://localhost:8080

# Overrides the frontend's API base URL entirely, bypassing the proxy (default: "/api", relative)
# VITE_API_BASE_URL=https://your-deployed-api.example.com/api
