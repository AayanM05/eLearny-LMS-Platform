{
  "expo": {
    "name": "eLearny LMS",
    "slug": "elearny-lms",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/logo-icon.png",
    "scheme": "elearny",
    "userInterfaceStyle": "dark",
    "updates": {
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "icon": "./assets/branding/logo-icon.png",
      "bundleIdentifier": "com.elearny.lms"
    },
    "android": {
      "package": "com.elearny.lms",
      "adaptiveIcon": {
        "backgroundColor": "#020617",
        "foregroundImage": "./assets/branding/logo-icon.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/branding/logo-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/branding/logo-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-updates"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "972970ec-14fe-4c7d-b32e-be4018a12612"
      }
    }
  }
}
